[
  {
    "start": 0.8,
    "end": 1.34,
    "text": "我叫陆照。"
  },
  {
    "start": 2.32,
    "end": 3.46,
    "text": "水籍上，"
  },
  {
    "start": 3.48,
    "end": 4.16,
    "text": "我已经死了。"
  },
  {
    "start": 7.78,
    "end": 8.4,
    "text": "六个月前，"
  },
  {
    "start": 9.14,
    "end": 10.44,
    "text": "父亲被判私开大闸，"
  },
  {
    "start": 11.14,
    "end": 11.84,
    "text": "家产没了。"
  },
  {
    "start": 12.64,
    "end": 13.32,
    "text": "我逃出来，"
  },
  {
    "start": 13.94,
    "end": 15.32,
    "text": "名字却留在了死册上。"
  },
  {
    "start": 18.3,
    "end": 18.66,
    "text": "三个人！"
  },
  {
    "start": 19.22,
    "end": 19.7,
    "text": "先开门！"
  },
  {
    "start": 20.2,
    "end": 21.64,
    "text": "关水的轮子在里面！"
  },
  {
    "start": 23.32,
    "end": 24.02,
    "text": "排水保货，"
  },
  {
    "start": 25.08,
    "end": 26.7,
    "text": "货主答应给我二百四十铜。"
  },
  {
    "start": 28.22,
    "end": 28.86,
    "text": "里面有木舌，"
  },
  {
    "start": 29.22,
    "end": 29.9,
    "text": "得顶过去！"
  }
]
